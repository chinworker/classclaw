[Unit]
Description=ClassClaw MediaMTX media relay
ConditionPathExists=!/opt/classclaw/backups/.upgrade-pending.json
After=network-online.target classclaw.service
Wants=network-online.target
PartOf=classclaw.service
BindsTo=classclaw.service

[Service]
Type=simple
User=classclaw
Group=classclaw
ExecStart=/usr/local/bin/mediamtx /etc/classclaw/mediamtx.yml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
TimeoutStopSec=20
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target

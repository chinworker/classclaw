CLASSCLAW_DATABASE_URL=sqlite:///./data/classclaw.db
CLASSCLAW_ATTACHMENT_DIR=./data/attachments
CLASSCLAW_MAX_ATTACHMENT_BYTES=20971520
CLASSCLAW_TIMEZONE=Asia/Shanghai
CLASSCLAW_LOG_LEVEL=INFO
CLASSCLAW_LOG_FILE=./data/logs/classclaw.log
CLASSCLAW_API_TOKEN=change-me-to-a-long-random-token
CLASSCLAW_AUTH_SESSION_HOURS=24
CLASSCLAW_DEFAULT_ADMIN_USERNAME=admin
CLASSCLAW_DEFAULT_ADMIN_PASSWORD=32767
CLASSCLAW_OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
CLASSCLAW_OPENCLAW_GATEWAY_TOKEN=replace-with-openclaw-gateway-token
CLASSCLAW_OPENCLAW_AGENT_ID=main
CLASSCLAW_OPENCLAW_EXTRACTOR_AGENT_ID=classclaw-extractor
CLASSCLAW_OPENCLAW_EXTRACTOR_ENABLED=true
CLASSCLAW_OPENCLAW_TIMEOUT_SECONDS=120
CLASSCLAW_OPENCLAW_CLASS_WORKSPACE_ROOT=./data/openclaw-agents
CLASSCLAW_OPENCLAW_STATE_DIR=~/.openclaw
CLASSCLAW_OPENCLAW_WECHAT_CHANNEL=openclaw-weixin

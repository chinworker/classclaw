# 只在这里保存密钥。非敏感配置请复制 config/classclaw.example.toml 为
# config/classclaw.toml 后修改，停机重启生效。

# 可选：生产环境可把配置文件放到 /etc/classclaw/classclaw.toml。
# CLASSCLAW_CONFIG_FILE=/etc/classclaw/classclaw.toml

# OpenClaw 插件调用 ClassClaw REST API 时使用；请生成长随机值，并与插件配置一致。
CLASSCLAW_API_TOKEN=replace-with-a-long-random-token

# OpenClaw Gateway 管理员 Token，只允许后端读取，绝不能发送到浏览器。
CLASSCLAW_OPENCLAW_GATEWAY_TOKEN=replace-with-openclaw-gateway-token

# 用于首次启动/完整初始化后的管理员密码，以及本地重置命令的目标密码。
# 重置现有管理员：python scripts/reset_admin_password.py（不输出密码）。登录后请再次改密。
CLASSCLAW_DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-initial-password

# 兼容旧部署：所有非敏感项仍可用既有 CLASSCLAW_* 环境变量覆盖 TOML。
# 环境变量优先级高于 TOML，通常只应作为临时应急覆盖使用。
# CLASSCLAW_OPENCLAW_CLASS_AGENT_THINKING=off

# 插件侧 ClassClaw 后端地址（默认 http://127.0.0.1:8000，在 OpenClaw 插件配置中调整）。

# OpenClaw Gateway 地址（默认 http://127.0.0.1:18789，按部署调整）。
# CLASSCLAW_OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789

# 出站 HTTP 是否信任 *_PROXY 环境变量；默认 false（见 app/services/http_client.py）。
# CLASSCLAW_TRUST_ENV=false
